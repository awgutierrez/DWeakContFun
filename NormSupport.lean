import Mathlib.Topology.ContinuousMap.Compact
import Mathlib.Analysis.Normed.Group.Basic
import Mathlib.Topology.Basic

noncomputable section

open Set Filter Topology

variable {K : Type*}
variable [TopologicalSpace K]
variable [CompactSpace K]
variable [T2Space K]
variable [Nonempty K]

set_option linter.style.whitespace false

/-!
# Norm attainment and support lemmas

This module contains the compactness argument for norm attainment and the
support argument for internal metric functionals.  It also contains the
small set-theoretic lemma that transfers pairwise disjointness to supports.
-/

/-! For a continuous real-valued function on a compact nonempty space, the norm is attained at some point. This supplies a point where an internal metric functional can be tested at its maximal value. -/
lemma norm_attains_at_point (g : C(K, ℝ)) :
    ∃ x : K, ‖g x‖ = ‖g‖ := by
  have hg : Continuous (fun x : K => ‖g x‖) := by
    exact Continuous.norm g.continuous
  have hK : IsCompact (Set.univ : Set K) := by
    exact isCompact_univ
  have hKne : (Set.univ : Set K).Nonempty := by
    exact Set.univ_nonempty

  obtain ⟨x, hx, hmax⟩ :=
    hK.exists_isMaxOn hKne hg.continuousOn

  have hmax' : ∀ y : K, ‖g y‖ ≤ ‖g x‖ := by
    intro y
    have hy := hmax (Set.mem_univ y)
    exact hy
  have hnorm_lower : ‖g‖ ≤ ‖g x‖ := by
    rw [ContinuousMap.norm_le g (norm_nonneg _)]
    exact hmax'
  have hnorm_upper : ‖g x‖ ≤ ‖g‖ := by
    exact ContinuousMap.norm_coe_le_norm g x

  exact ⟨x, le_antisymm hnorm_upper hnorm_lower⟩

/-! If internal metric functional $h_g$ is negative at $f$,
then $x$ is in the support of $f$ -/
/-! Suppose that x is a norm-attaining point for g. Then,
  ‖f−g‖−‖g‖<0 ⟹ x∈supp(f) -/
/-! If the internal metric functional generated by g is negative at f, then every norm-attaining point of g must lie in the support of f. This is the key local support lemma. -/
lemma internal_negative_imp_mem_support
    (g f : C(K, ℝ))
    (x : K)
    (hx : ‖g x‖ = ‖g‖)
    (hneg : ‖f - g‖ - ‖g‖ < 0) :
    x ∈ Function.support f := by
  by_contra hxsupport

  have hfx : f x = 0 := by
    rw [Function.mem_support] at hxsupport
    exact not_ne_iff.mp hxsupport
  have hpoint : ‖(f - g) x‖ ≤ ‖f - g‖ := by
    exact ContinuousMap.norm_coe_le_norm (f - g) x
  have hpoint_eq : ‖(f - g) x‖ = ‖g x‖ := by
    simp [hfx]
  have hnorm : ‖g‖ ≤ ‖f - g‖ := by
    rw [← hx]
    rw [← hpoint_eq]
    exact hpoint

  linarith

/-!​​​ For a fixed internal $h_g$, we have
$h_g(f_n)<0$ for at most one n-/
/-! That is,
$#{n : ‖f_n - g‖ - ‖g‖ < 0} ≤ 1$
-/
/-! For pairwise disjoint supports, a fixed internal metric functional can be negative on at most one member of the sequence. -/
lemma internal_negative_at_most_one
    (f : ℕ → C(K, ℝ))
    (hdisjoint :
      ∀ ⦃m n : ℕ⦄, m ≠ n →
        Disjoint (Function.support (f m)) (Function.support (f n)))
    (g : C(K, ℝ)) :
    ∀ ⦃m n : ℕ⦄,
      ‖f m - g‖ - ‖g‖ < 0 →
      ‖f n - g‖ - ‖g‖ < 0 →
      m = n := by
  intro m n hm hn
  obtain ⟨x, hx⟩ := norm_attains_at_point g
  have hxm : x ∈ Function.support (f m) := by
    exact internal_negative_imp_mem_support g (f m) x hx hm
  have hxn : x ∈ Function.support (f n) := by
    exact internal_negative_imp_mem_support g (f n) x hx hn
  by_contra hmn
  have hdis :
      Disjoint (Function.support (f m)) (Function.support (f n)) :=
    hdisjoint hmn
  exact Set.disjoint_left.1 hdis hxm hxn

/-! Transfer pairwise disjointness from ambient sets to supports. -/
/-! If each support is contained in a corresponding ambient set and the ambient sets are pairwise disjoint, then the supports are pairwise disjoint. -/
lemma disjoint_supports_of_subset
    (f : ℕ → C(K, ℝ))
    (I : ℕ → Set K)
    (hsupport : ∀ n, Function.support (f n) ⊆ I n)
    (hdisjoint :
      ∀ ⦃m n : ℕ⦄, m ≠ n → Disjoint (I m) (I n)) :
    ∀ ⦃m n : ℕ⦄, m ≠ n →
      Disjoint (Function.support (f m)) (Function.support (f n)) := by
  intro m n hmn
  exact Set.disjoint_of_subset_left
    (hsupport m)
    (Set.disjoint_of_subset_right (hsupport n) (hdisjoint hmn))
